# ---- Server ----
NODE_ENV=development
PORT=4000

# ---- Database (AWS RDS MySQL in production, mysql container in dev) ----
DB_HOST=mysql
DB_PORT=3306
DB_NAME=collegekhoj
DB_USER=collegekhoj_app
DB_PASSWORD=change_me_in_env_never_in_git
DB_CONNECTION_LIMIT=10

# ---- Auth ----
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ---- CORS ----
CORS_ORIGIN=http://localhost:5173

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ---- AWS (production only — never commit real values) ----
AWS_REGION=ap-south-1
AWS_S3_BUCKET=collegekhoj-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
